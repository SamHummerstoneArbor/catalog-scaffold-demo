# direnv config: prefer OpenTofu, fall back to Terraform.
#
# Terragrunt defaults to `tofu`. If you only have Terraform installed, this points it there so
# nothing in the demo has to change. Not using direnv? Run the same line by hand:
#
#     export TG_TF_PATH="$(command -v tofu || command -v terraform)"
#
export TG_TF_PATH="$(command -v tofu || command -v terraform)"
